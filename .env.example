APP_NAME=XAU/USD Trading Bot
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost"]
DATABASE_URL=sqlite+aiosqlite:///./backend/data/trading_bot.db
LOG_LEVEL=INFO

# Milestone 10.7 SQLite recovery. Blank destinations/key fail closed when an
# operator recovery command is invoked; never commit key material.
BACKUP_RPO_HOURS=24
BACKUP_RTO_HOURS=2
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3
BACKUP_LOCAL_DIRECTORY=
BACKUP_OFFHOST_DIRECTORY=
BACKUP_ENCRYPTION_REQUIRED=true
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_ENV=BACKUP_ENCRYPTION_KEY
BACKUP_COMPRESSION=gzip
BACKUP_BUSY_TIMEOUT_SECONDS=30
BACKUP_OPERATION_TIMEOUT_SECONDS=3600

# Authentication. false is only for local HTTP; production requires true.
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_TRUSTED_PROXIES=[]
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=300
AUTH_ACCOUNT_LOCKOUT_ATTEMPTS=5
AUTH_ACCOUNT_LOCKOUT_SECONDS=900

VITE_API_BASE_URL=/api/v1
FRONTEND_PORT=5173

# Safe placeholders only. Replace with credentials for a DEMO account; real accounts are rejected.
MT5_LOGIN=<DEMO_ACCOUNT_LOGIN>
MT5_PASSWORD=<DEMO_ACCOUNT_PASSWORD>
MT5_SERVER=<EXACT_DEMO_SERVER_NAME>
MT5_PATH=C:\Path\To\MetaTrader 5\terminal64.exe
MT5_SYMBOL=XAUUSD
# Milestone 10.3 hard deadlines and isolated connector recovery.
MT5_CONNECT_RETRIES=3
MT5_RETRY_DELAY_SECONDS=1
MT5_TIMEOUT_MS=10000
MT5_VENDOR_TIMEOUT_MS=3000
MT5_ORDER_SEND_TIMEOUT_MS=10000
MT5_HEARTBEAT_TIMEOUT_MS=1000
MT5_HEARTBEAT_INTERVAL_SECONDS=5
MT5_RECOVERY_RETRIES=3
MT5_RECOVERY_DELAY_SECONDS=1
MARKET_TICK_CACHE_TTL_SECONDS=0.25
MARKET_CANDLE_CACHE_TTL_SECONDS=1.0
MARKET_CACHE_MAX_ENTRIES=128
MARKET_MAX_CANDLES=1000
MARKET_WS_INTERVAL_SECONDS=1.0

# Milestone 10.4 in-process authenticated WebSocket hub and fan-out limits.
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_CONNECTIONS_PER_IP=20
WS_MAX_TOTAL_CONNECTIONS=200
WS_IDLE_TIMEOUT_SECONDS=120
WS_HEARTBEAT_INTERVAL_SECONDS=15
WS_HEARTBEAT_TIMEOUT_SECONDS=10
WS_CLIENT_BUFFER_SIZE=32
WS_SLOW_CLIENT_DROP_LIMIT=8
WS_SEND_TIMEOUT_SECONDS=5
WS_HANDSHAKE_RATE_LIMIT=30
WS_HANDSHAKE_RATE_WINDOW_SECONDS=60
WS_RECONNECT_RATE_LIMIT=20
WS_RECONNECT_RATE_WINDOW_SECONDS=60
WS_SUBSCRIBE_RATE_LIMIT=20
WS_SUBSCRIBE_RATE_WINDOW_SECONDS=60
WS_SESSION_REVALIDATE_SECONDS=30

# Milestone 10.2 bounded native backtest coordinator and secure CSV staging.
MAX_BACKTEST_JOBS=1
MAX_PENDING_JOBS=3
MAX_CANDLES=100000
MAX_DATE_RANGE_DAYS=365
MAX_CSV_SIZE_MB=50
MAX_CSV_ROWS=100000
MAX_MEMORY_BUDGET_MB=512
JOB_TIMEOUT_MINUTES=30

ANALYSIS_EMA_FAST_PERIOD=20
ANALYSIS_EMA_SLOW_PERIOD=50
ANALYSIS_RSI_PERIOD=14
ANALYSIS_ATR_PERIOD=14
ANALYSIS_RSI_OVERBOUGHT=70
ANALYSIS_RSI_OVERSOLD=30
ANALYSIS_MAX_SPREAD_POINTS=300
ANALYSIS_CANDLE_COUNT=120
ANALYSIS_CANDLE_BODY_ATR_MIN=0.2
ANALYSIS_CANDLE_CLOSE_LOCATION_MIN=0.65
ANALYSIS_STRUCTURE_LOOKBACK=20
ANALYSIS_SR_LOOKBACK=50
ANALYSIS_SWING_WINDOW=2
ANALYSIS_MAX_LEVELS=5
ANALYSIS_STRATEGY_NAME=EMA_RSI_ATR_MTF_V1
RISK_PER_TRADE_PERCENT=1.0
RISK_MAX_DAILY_LOSS_PERCENT=3.0
RISK_MAX_DAILY_DRAWDOWN_PERCENT=5.0
RISK_MAX_CONSECUTIVE_LOSSES=3
RISK_MAX_TRADES_PER_DAY=5
RISK_MAX_OPEN_POSITIONS=1
RISK_MINIMUM_RISK_REWARD=1.5
RISK_TARGET_RISK_REWARD=2.0
RISK_MAXIMUM_SPREAD_POINTS=300
RISK_COOLDOWN_MINUTES_AFTER_LOSS=30
RISK_USE_EQUITY_FOR_RISK=true
RISK_BREAK_EVEN_ENABLED=false
RISK_TRAILING_STOP_ENABLED=false
RISK_STOP_LOSS_METHOD=ATR
RISK_ATR_MULTIPLIER=1.5
RISK_SESSION_ENABLED=true
RISK_SESSION_START_HOUR_UTC=0
RISK_SESSION_END_HOUR_UTC=24
RISK_SESSION_WEEKDAYS=[0,1,2,3,4]
PAPER_INITIAL_BALANCE=10000
PAPER_SLIPPAGE_POINTS=0
PAPER_COMMISSION_PER_LOT=0
PAPER_SWAP_LONG_PER_LOT=0
PAPER_SWAP_SHORT_PER_LOT=0
PAPER_UPDATE_INTERVAL_SECONDS=1
PAPER_AUTO_TRADE_ENABLED=false
PAPER_MAXIMUM_OPEN_POSITIONS=1
PAPER_ALLOW_MANUAL_TRADE_PLAN=true
PAPER_CLOSE_POSITIONS_ON_STOP=false
PAPER_EMERGENCY_CLOSE_POSITIONS=true
PAPER_BREAK_EVEN_ENABLED=false
PAPER_BREAK_EVEN_TRIGGER_R=1
PAPER_TRAILING_STOP_ENABLED=false
PAPER_TRAILING_STOP_METHOD=POINTS
PAPER_TRAILING_DISTANCE_POINTS=0
PAPER_TRAILING_ATR_MULTIPLIER=1

# Broker-demo execution is fail-closed. Keep disabled until explicitly configured.
# Access is controlled by central authentication and RBAC permissions.
DEMO_EXECUTION_ENABLED=false
DEMO_EXECUTION_MODE=MANUAL_DEMO
DEMO_MAGIC=9072026
DEMO_COMMENT=bot-demo
DEMO_DEVIATION_POINTS=20
DEMO_MAXIMUM_SPREAD_POINTS=300
DEMO_INTENT_TTL_SECONDS=300
DEMO_EMERGENCY_CLOSE_POSITIONS=false
DEMO_TRAILING_STOP_ENABLED=false
DEMO_TRAILING_DISTANCE_POINTS=0
DEMO_RATE_LIMIT_REQUESTS=60
DEMO_RATE_LIMIT_WINDOW_SECONDS=60
DEMO_RATE_LIMIT_MAX_CLIENTS=1024

# Milestone 9.5 safety layer. All trading remains fail-closed when a guardian blocks.
SAFETY_ENABLED=true
SAFETY_MAX_SPREAD_POINTS=300
SAFETY_ACTIVE_SESSIONS=LONDON,NEW_YORK,ASIA
SAFETY_CUSTOM_TIMEZONE=UTC
SAFETY_CUSTOM_START_HOUR=0
SAFETY_CUSTOM_END_HOUR=24
SAFETY_NEWS_REQUIRED=false
SAFETY_NEWS_BLACKOUT_BEFORE_MINUTES=30
SAFETY_NEWS_BLACKOUT_AFTER_MINUTES=30
SAFETY_CIRCUIT_ERROR_THRESHOLD=5
SAFETY_CIRCUIT_WINDOW_MINUTES=30
SAFETY_CIRCUIT_LOCK_MINUTES=30
SAFETY_HEARTBEAT_INTERVAL_SECONDS=5
